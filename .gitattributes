# ONNX protobuf headers can contain more than 8 KiB of text before binary weights.
# Preserve exact model bytes and prevent text/whitespace diffs and newline conversion.
*.onnx binary
*.so binary
# Preserve upstream generated-header EOF spacing.
app/src/main/cpp/vendor/ncnn/** whitespace=-blank-at-eof
# Package assets verbatim from Git, including upstream scripts and dictionaries.
app/src/main/assets/** -text

# GitHub 语言统计：落地页、宣传页与测试夹具不是产品代码，不计入语言占比。
docs/promo-site/** linguist-documentation
promo/** linguist-documentation
app/src/test/resources/** linguist-vendored
app/src/androidTest/assets/** linguist-vendored
*.html linguist-documentation
